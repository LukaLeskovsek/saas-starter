# =============================================================================
# Ključi in nastavitve aplikacije.
#
# Živijo tu (lokalno, v .env.local) in v nastavitvah projekta na Vercelu.
# Nikoli v kodi, nikoli v klepetu.
#
# Nastavitev: Claude kopira to datoteko v ".env.local" in vpiše javne vrednosti.
# Skrivne ključe prilepiš ti, takoj za znakom "=", brez presledkov in narekovajev.
# .env.local Git ignorira, zato tvoji ključi nikoli ne pridejo na GitHub.
# Preverba brez izpisa vrednosti: npm run env:check
# =============================================================================

# --- Supabase: prijava in baza ---
# Supabase → Project Settings → API (oboje vpiše Claude prek Supabase MCP)
NEXT_PUBLIC_SUPABASE_URL=           # naslov projekta, npr. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # javni (anon / publishable) ključ; varen v brskalniku, zaščito daje RLS

# Le če NE uporabljaš Supabase MCP: z njim Claude prek `npm run db:run` požene migracije.
# supabase.com → Account → Access Tokens. Velja za cel račun; po programu ga prekliči.
SUPABASE_ACCESS_TOKEN=

# Rezervirano, ta predloga ga NE uporablja (javni ključ in RLS zadoščata). Če ga kdaj
# dodaš, je SAMO za strežnik: nikoli s predpono NEXT_PUBLIC, nikoli v kodi.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Resend: e-pošta iz aplikacije (neobvezno) ---
# resend.com → API Keys. Brez ključa aplikacija e-pošte preprosto ne pošlje.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev    # testni pošiljatelj; pošta pride samo na tvoj naslov.
                                    # Po programu potrdi svojo domeno in vpiši naslov na njej.

# --- Sentry: spremljanje napak (neobvezno) ---
# Sentry → tvoj projekt → Settings → Client Keys (DSN). DSN je javen (varen v brskalniku).
NEXT_PUBLIC_SENTRY_DSN=
# Neobvezno, na Vercelu za nalaganje source map (lokalno pusti prazno):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# --- AI: klici jezikovnega modela (lib/ai.ts) (neobvezno) ---
# Tvoj ključ OpenRouter (openrouter.ai → Keys), z omejitvijo porabe.
# SAMO za strežnik: nikoli s predpono NEXT_PUBLIC, nikoli v kodi. Prazno = demo odgovori
# (vzorčno besedilo, brez stroškov); funkcija vseeno deluje.
OPENROUTER_API_KEY=
# Privzeti model je Claude prek OpenRouterja. Trenutno ime preveri na openrouter.ai/models.
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# Kdo odgovarja na generate() (lib/ai.ts):
#   openrouter   (privzeto) — plačilo po porabi s ključem zgoraj; to uporabi na Vercelu.
#   local-claude           — tvoj LOKALNI Claude Code (`claude -p`): odgovarja tvoja naročnina
#                            Claude, brez ključa in brez plačila po porabi. Deluje samo na
#                            tvojem računalniku (claude nameščen in prijavljen).
# POMEMBNO: z local-claude tu NE nastavi ANTHROPIC_API_KEY, sicer Claude Code namesto
# naročnine zaračuna API po porabi.
AI_BACKEND=openrouter
# Neobvezno (le local-claude): mapa s profilom podjetja, iz katere Claude črpa kontekst.
AI_BRAIN_DIR=
# Največ pravih klicev OpenRouter na prijavljenega uporabnika na dan (UTC). Prazno = 20.
AI_DAILY_LIMIT_PER_USER=20

# --- Stran ---
# Lokalno http://localhost:3000. Na Vercelu živi naslov (nastavi ga `npm run vercel:env -- --site-url …`).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
